# Cloudflare Pages response headers. Strict CSP: everything is first-party, no inline script or style.
# no-transform on every response: Cloudflare must not rewrite what we serve (on this zone it would inject its analytics
# beacon into every page and obfuscate email addresses). Blocks that set their own caching detach this one first.
# Cloudflare-CDN-Cache-Control caps Cloudflare's own cache at 5 minutes for everything, so a deleted or changed file
# clears itself; browsers keep the Cache-Control below.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'none'; media-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: all
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Cloudflare-CDN-Cache-Control: max-age=300

# The static demo house (FE-S3): its own CSP replaces the global one (the app sets inline styles; scripts stay first-party,
# and it talks only to this origin). The CSP snippet is copied byte for byte from the bundle; check-site verifies it.
# Keep CSP and caching in ONE block: Wrangler indexes rules by path, so a duplicate path drops the earlier block.
/demo/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  ! Cache-Control
  Cache-Control: no-cache, no-transform

# Versioned CSS/JS (site.v<N>.*) and fonts never change in place.
/assets/site.*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

# Images, clips and brand files keep their names across updates, so cache them for a day.
/assets/shots/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, no-transform
/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, no-transform
  Access-Control-Allow-Origin: *
/assets/clips/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, no-transform

# Preview deployments (*.pages.dev) should not be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Content-addressed demo assets; entry and metadata keep /demo/* no-cache.
/demo/v/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
